    { "id": "gateway-auth-off", "severity": "error", "message": "Autenticação do Gateway aparenta estar desligada.", "suggestion": "Activar autenticação antes de expor a interface ou nós remotos." },
    { "id": "elevated-without-allowfrom", "severity": "warning", "message": "Execução elevada activa sem allowFrom evidente.", "suggestion": "Definir allowFrom por canal/agente." },
    { "id": "agent-full-exec-no-ask", "severity": "warning", "message": "Execução full sem confirmação.", "suggestion": "Aceitável em agentes internos controlados; evitar em agentes expostos a canais públicos." },
    { "id": "heartbeat-disabled", "severity": "info", "message": "Heartbeat desactivado.", "suggestion": "0m é tratado como desactivado." },
    { "id": "secret-inline", "severity": "warning", "message": "Segredo em texto claro.", "suggestion": "Preferir variável de ambiente ou secret reference. Se já foi partilhado, rodar este segredo." }
